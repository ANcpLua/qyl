<Project>
  <PropertyGroup Label="qyl Product Version">
    <!-- The NuGet trusted-publishing workflow reads this exact product version. Bump it before
         any package-affecting main commit once the current immutable version has been published. -->
    <QylVersion>0.1.0-beta.12</QylVersion>
    <Version>$(QylVersion)</Version>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <DotNetRuntimeVersion>10.0.10</DotNetRuntimeVersion>
    <MicrosoftExtensionsVersion>10.8.0</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsAiVersion>10.8.1</MicrosoftExtensionsAiVersion>
    <!-- Microsoft.Extensions.AI.Evaluation does not share the Microsoft.Extensions.AI release
         line and lags it. Transitive pinning is on, so a single shared property pins
         .Evaluation to whatever .AI is bumped to, and restore fails with NU1102 the moment
         that version has not shipped for .Evaluation. Bump these two independently. -->
    <MicrosoftExtensionsAiEvaluationVersion>10.8.0</MicrosoftExtensionsAiEvaluationVersion>
    <OpenTelemetryVersion>1.17.0</OpenTelemetryVersion>
    <OpenTelemetryAspNetCoreInstrumentationVersion>1.17.0</OpenTelemetryAspNetCoreInstrumentationVersion>
    <!-- Held at 1.5.3: 1.5.4 and 1.5.5 stop reusing freed blocks after a
         checkpointed delete, so a replacement ingest grows the file from 41.5 MiB
         to 77 MiB instead of capping at the pre-deletion peak. Caught by
         RetentionTests.Checkpointed_retention_reuses_space_without_exceeding_the_pre_deletion_peak;
         bisected to 1.5.4. Retention would not bound collector disk use on 1.5.4+. -->
    <DuckDBVersion>1.5.3</DuckDBVersion>
    <GoogleProtobufVersion>3.35.1</GoogleProtobufVersion>
    <GrpcAspNetCoreVersion>2.80.0</GrpcAspNetCoreVersion>
    <GrpcToolsVersion>2.83.0</GrpcToolsVersion>
    <ANcpLuaRoslynUtilitiesVersion>2.2.42</ANcpLuaRoslynUtilitiesVersion>
    <ANcpLuaAgentsVersion>1.13.8</ANcpLuaAgentsVersion>
    <QylApiContractsVersion>2.1.0</QylApiContractsVersion>
    <QylSdkVersion>8.3.0</QylSdkVersion>

    <!-- Mirrors the SDK values so standalone checkouts resolve the same MAF graph.
         ANcpLua.Agents 1.13.6 depends on Microsoft.Agents.AI(.Abstractions) 1.13.0 — keep in lockstep. -->
    <MicrosoftAgentsAIVersion>1.13.0</MicrosoftAgentsAIVersion>
    <MicrosoftAgentsAIHostingVersion>1.13.0-preview.260703.1</MicrosoftAgentsAIHostingVersion>

    <NukeVersion>10.1.0</NukeVersion>
    <SpectreConsoleVersion>0.57.2</SpectreConsoleVersion>
    <VersionizeVersion>2.5.0</VersionizeVersion>
  </PropertyGroup>
</Project>
