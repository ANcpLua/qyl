<Project>
  <PropertyGroup Label="qyl Product Version">
    <!-- The NuGet trusted-publishing workflow reads this exact product version. Bump it before
         any package-affecting main commit once the current immutable version has been published. -->
    <QylVersion>1.1.4</QylVersion>
    <Version>$(QylVersion)</Version>
  </PropertyGroup>

  <!-- Every PackageVersion in Directory.Packages.props resolves through a property declared here.
       No version literal lives in that file, so a bump is a one-line edit in one place and the
       shared lines (a runtime, a release train) cannot drift apart by being typed twice. -->

  <PropertyGroup Label="Platform">
    <DotNetRuntimeVersion>10.0.10</DotNetRuntimeVersion>
    <MicrosoftExtensionsVersion>10.8.0</MicrosoftExtensionsVersion>
    <!-- Microsoft.AspNetCore.OpenApi still generates assignments incompatible with Microsoft.OpenApi 3.x
         (verified 2026-07-16 against 3.9.0: its XmlCommentGenerator emits `IOpenApiMediaType.Example = ...`,
         read-only in 3.x -> CS0200). Hold on the newest 2.x, which is patched for GHSA-v5pm-xwqc-g5wc;
         retry 3.x when AspNetCore.OpenApi ships a 3.x-compatible generator. Transitive-only pin. -->
    <MicrosoftOpenApiVersion>2.11.0</MicrosoftOpenApiVersion>
    <RoslynVersion>5.6.0</RoslynVersion>
  </PropertyGroup>

  <PropertyGroup Label="qyl-owned packages">
    <!-- The producer family ships from the Qyl.OpenTelemetry.AutoInstrumentation repo on one
         release line (Qyl.Telemetry.* package IDs since 9.0.0), so its packages share one property. -->
    <QylTelemetryVersion>9.0.1</QylTelemetryVersion>
    <QylSemanticConventionsVersion>1.0.0</QylSemanticConventionsVersion>
    <QylApiContractsVersion>7.0.0</QylApiContractsVersion>
    <!-- Also read directly by qyl.instrumentation.generators to locate the Sources contentFiles. -->
    <ANcpLuaRoslynUtilitiesVersion>2.2.42</ANcpLuaRoslynUtilitiesVersion>
  </PropertyGroup>

  <PropertyGroup Label="Telemetry and wire">
    <OpenTelemetryVersion>1.17.0</OpenTelemetryVersion>
    <!-- The earlier "1.5.4+ grows without limit" finding was wrong; a CLI repro disproved
         it (2026-07-26). Retention's space reuse rides the experimental
         vacuum_rebuild_indexes option in DuckDbStore's connection string, and 1.5.4/1.5.5
         changed when that path runs: 1.5.3 fully rebuilt indexes on database open (doubling
         the file up front, which the old single-cycle test mistook for a reuse cap), while
         1.5.5 compacts lazily and converges to a *smaller* steady state (68 vs 81 MiB in
         the gate's workload). Multi-cycle boundedness is asserted by
         RetentionTests.Repeated_retention_cycles_bound_the_database_file_at_a_steady_state;
         run it after any DuckDB bump because the option is experimental and its trigger
         timing has shifted between patch releases before. -->
    <DuckDBVersion>1.5.5</DuckDBVersion>
    <GoogleProtobufVersion>3.35.1</GoogleProtobufVersion>
    <GrpcAspNetCoreVersion>2.80.0</GrpcAspNetCoreVersion>
    <GrpcToolsVersion>2.83.0</GrpcToolsVersion>
  </PropertyGroup>

  <PropertyGroup Label="Build and test tooling">
    <NukeVersion>10.1.0</NukeVersion>
    <SpectreConsoleVersion>0.57.2</SpectreConsoleVersion>
    <VersionizeVersion>2.5.0</VersionizeVersion>
    <XunitVersion>3.2.2</XunitVersion>
    <DockerfileModelVersion>2.0.0</DockerfileModelVersion>
    <YamlDotNetVersion>18.1.0</YamlDotNetVersion>
    <NetFrameworkReferenceAssembliesVersion>1.0.3</NetFrameworkReferenceAssembliesVersion>
    <!-- Nuke.ProjectModel requires this floor under transitive pinning. -->
    <MicrosoftBuildVersion>18.7.1</MicrosoftBuildVersion>
    <!-- Overrides a vulnerable Nuke.Common transitive. -->
    <NuGetPackagingVersion>7.6.0</NuGetPackagingVersion>
  </PropertyGroup>
</Project>
