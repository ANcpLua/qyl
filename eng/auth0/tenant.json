{
  "tenant": "qyl-eu.eu.auth0.com",
  "resource": {
    "identifier": "https://mcp.qyl.at/mcp",
    "enforce_policies": true,
    "skip_consent_for_verifiable_first_party_clients": false,
    "scopes": [
      { "value": "qyl:read", "description": "Read qyl telemetry and MCP evidence" },
      { "value": "qyl:write", "description": "Create and update annotations and saved queries in your qyl project" },
      { "value": "qyl:delete", "description": "Delete annotations and saved queries in your qyl project" }
    ]
  },
  "user_client_names": [
    "ChatGPT", "Claude", "Claude Code", "Codex", "qyl MCP Inspector review",
    "qyl-workspace hosted eval", "qyl.mcp (Test Application)"
  ],
  "user_scopes": ["qyl:read", "qyl:write", "qyl:delete"],
  "user_subjects_environment": "MCP_COLLECTOR_PROJECTS",
  "third_party_default": { "scope": [], "allow_all_scopes": false },
  "tenant_flags": { "use_scope_descriptions_for_consent": true },
  "dashboard_only": { "dynamic_client_registration_security_mode": "strict" }
}
