<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(QylOrchestrationPackageVersion)' == ''">
    <ProjectReference Include="../../../packages/Qyl.Orchestration/Qyl.Orchestration.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(QylOrchestrationPackageVersion)' != ''">
    <PackageReference Include="Qyl.Orchestration" VersionOverride="$(QylOrchestrationPackageVersion)" />
  </ItemGroup>
</Project>
