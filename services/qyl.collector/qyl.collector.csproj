<Project Sdk="ANcpLua.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Qyl.Collector</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <LangVersion>14</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Qyl.Instrumentation.Generators</InterceptorsNamespaces>
  </PropertyGroup>

  <PropertyGroup>
    <QylAot Condition="'$(QylAot)' == ''">true</QylAot>
    <PublishAot Condition="'$(QylAot)' == 'true'">true</PublishAot>
    <PublishTrimmed Condition="'$(QylAot)' == 'true'">true</PublishTrimmed>
    <!-- Analyzers are meaningful only with the Request Delegate Generator active (QylAot=true,
         the shipping config); without it the reflective MapGet/MapPost overloads flag IL2026/IL3050
         that the published artifact never contains. -->
    <EnableTrimAnalyzer Condition="'$(QylAot)' == 'true'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(QylAot)' == 'true'">true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer Condition="'$(QylAot)' == 'true'">true</EnableSingleFileAnalyzer>
    <WarningsNotAsErrors Condition="'$(QylAot)' == 'true'">$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Release artifacts serve dashboard, API, and OTLP from one origin. -->
    <QylEmbedDashboard Condition="'$(QylEmbedDashboard)' == '' AND '$(Configuration)' == 'Release'">true</QylEmbedDashboard>
    <QylEmbedDashboard Condition="'$(QylEmbedDashboard)' == ''">false</QylEmbedDashboard>
  </PropertyGroup>

  <PropertyGroup>
    <QylCheckpointNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</QylCheckpointNativeRid>
    <QylCheckpointNativeRid Condition="'$(QylCheckpointNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</QylCheckpointNativeRid>
    <QylCheckpointNativeFamily Condition="'$(QylCheckpointNativeRid)' == 'linux-x64' OR '$(QylCheckpointNativeRid)' == 'linux-arm64'">linux</QylCheckpointNativeFamily>
    <QylCheckpointNativeFamily Condition="'$(QylCheckpointNativeRid)' == 'osx-x64' OR '$(QylCheckpointNativeRid)' == 'osx-arm64'">osx</QylCheckpointNativeFamily>
    <QylCheckpointNativeHostFamily Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</QylCheckpointNativeHostFamily>
    <QylCheckpointNativeHostFamily Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</QylCheckpointNativeHostFamily>
    <QylCheckpointNativeArchitecture Condition="'$(QylCheckpointNativeRid)' == 'linux-x64' OR '$(QylCheckpointNativeRid)' == 'osx-x64'">x86_64</QylCheckpointNativeArchitecture>
    <QylCheckpointNativeArchitecture Condition="'$(QylCheckpointNativeRid)' == 'linux-arm64' OR '$(QylCheckpointNativeRid)' == 'osx-arm64'">arm64</QylCheckpointNativeArchitecture>
    <QylCheckpointNativeHostArchitecture Condition="$(NETCoreSdkRuntimeIdentifier.EndsWith('-x64'))">x86_64</QylCheckpointNativeHostArchitecture>
    <QylCheckpointNativeHostArchitecture Condition="$(NETCoreSdkRuntimeIdentifier.EndsWith('-arm64'))">arm64</QylCheckpointNativeHostArchitecture>
    <QylCheckpointNativeCanBuild Condition="'$(QylCheckpointNativeHostFamily)' == '$(QylCheckpointNativeFamily)' AND ('$(QylCheckpointNativeFamily)' == 'osx' OR '$(QylCheckpointNativeArchitecture)' == '$(QylCheckpointNativeHostArchitecture)')">true</QylCheckpointNativeCanBuild>
    <QylCheckpointNativeExtension Condition="'$(QylCheckpointNativeFamily)' == 'linux'">.so</QylCheckpointNativeExtension>
    <QylCheckpointNativeExtension Condition="'$(QylCheckpointNativeFamily)' == 'osx'">.dylib</QylCheckpointNativeExtension>
    <QylCheckpointNativeMacOsMinimumVersion>12.0</QylCheckpointNativeMacOsMinimumVersion>
    <QylCheckpointNativeFileName>libqyl_checkpoint_native$(QylCheckpointNativeExtension)</QylCheckpointNativeFileName>
    <QylCheckpointNativeStaticFileName>libqyl_checkpoint_native.a</QylCheckpointNativeStaticFileName>
    <QylCheckpointNativeObjectFileName>qyl_checkpoint_native.o</QylCheckpointNativeObjectFileName>
    <QylCheckpointNativeSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'Native', 'qyl_checkpoint_native.c'))</QylCheckpointNativeSource>
    <QylCheckpointNativeOutputDirectory>$([MSBuild]::NormalizeDirectory('$(BaseIntermediateOutputPath)', 'qyl-native', '$(Configuration)', '$(TargetFramework)', '$(QylCheckpointNativeRid)'))</QylCheckpointNativeOutputDirectory>
    <QylCheckpointNativeOutput>$([MSBuild]::NormalizePath('$(QylCheckpointNativeOutputDirectory)', '$(QylCheckpointNativeFileName)'))</QylCheckpointNativeOutput>
    <QylCheckpointNativeStaticOutput>$([MSBuild]::NormalizePath('$(QylCheckpointNativeOutputDirectory)', '$(QylCheckpointNativeStaticFileName)'))</QylCheckpointNativeStaticOutput>
    <QylCheckpointNativeObjectOutput>$([MSBuild]::NormalizePath('$(QylCheckpointNativeOutputDirectory)', '$(QylCheckpointNativeObjectFileName)'))</QylCheckpointNativeObjectOutput>
  </PropertyGroup>

  <ItemGroup Condition="'$(QylCheckpointNativeCanBuild)' == 'true'">
    <Content Include="$(QylCheckpointNativeOutput)">
      <!-- Managed LibraryImport resolves beside the application. NativeAOT
           consumes the static archive instead and must not ship this sidecar. -->
      <TargetPath>$(QylCheckpointNativeFileName)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(PublishAot)' != 'true'">PreserveNewest</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'$(PublishAot)' == 'true'">Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- NativeAOT binds this P/Invoke directly and consumes the archive at the
       final native link. The shipping executable therefore has no loader-path
       dependency on a loose checkpoint sidecar. Managed builds and tool
       packages keep the matching host sidecar beside the collector assembly. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND '$(QylCheckpointNativeCanBuild)' == 'true'">
    <DirectPInvoke Include="qyl_checkpoint_native"/>
    <NativeLibrary Include="$(QylCheckpointNativeStaticOutput)"/>
  </ItemGroup>

  <!-- The asset is compiled only when the host toolchain matches the target,
       because the multi-RID tool package publishes this project for every RID
       from a single host; failing there would make packaging impossible off the
       target OS. The delivery contract is enforced where it is actually
       required: NativeAOT consumes the static archive, the Dockerfile rejects a
       loose sidecar, and the deployment smoke executes checkpoint publication. -->

  <Target Name="QylCompileCheckpointNative"
          BeforeTargets="CoreCompile;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems"
          Inputs="$(QylCheckpointNativeSource)"
          Outputs="$(QylCheckpointNativeOutput);$(QylCheckpointNativeStaticOutput)"
          Condition="'$(QylCheckpointNativeCanBuild)' == 'true'">
    <MakeDir Directories="$(QylCheckpointNativeOutputDirectory)"/>
    <Exec Condition="'$(QylCheckpointNativeFamily)' == 'linux'"
          Command="clang -std=c11 -O2 -fPIC -fvisibility=hidden -shared -Wl,-z,relro,-z,now -Wl,--no-undefined -o &quot;$(QylCheckpointNativeOutput)&quot; &quot;$(QylCheckpointNativeSource)&quot;"/>
    <Exec Condition="'$(QylCheckpointNativeFamily)' == 'linux'"
          Command="clang -std=c11 -O2 -fPIC -fvisibility=hidden -c -o &quot;$(QylCheckpointNativeObjectOutput)&quot; &quot;$(QylCheckpointNativeSource)&quot;"/>
    <Exec Condition="'$(QylCheckpointNativeFamily)' == 'osx'"
          Command="clang -std=c11 -O2 -fPIC -fvisibility=hidden -mmacosx-version-min=$(QylCheckpointNativeMacOsMinimumVersion) -dynamiclib -arch $(QylCheckpointNativeArchitecture) -Wl,-install_name,@rpath/$(QylCheckpointNativeFileName) -o &quot;$(QylCheckpointNativeOutput)&quot; &quot;$(QylCheckpointNativeSource)&quot;"/>
    <Exec Condition="'$(QylCheckpointNativeFamily)' == 'osx'"
          Command="clang -std=c11 -O2 -fPIC -fvisibility=hidden -mmacosx-version-min=$(QylCheckpointNativeMacOsMinimumVersion) -arch $(QylCheckpointNativeArchitecture) -c -o &quot;$(QylCheckpointNativeObjectOutput)&quot; &quot;$(QylCheckpointNativeSource)&quot;"/>
    <Exec Command="ar rcs &quot;$(QylCheckpointNativeStaticOutput)&quot; &quot;$(QylCheckpointNativeObjectOutput)&quot;"/>
    <ItemGroup>
      <FileWrites Include="$(QylCheckpointNativeOutput);$(QylCheckpointNativeStaticOutput);$(QylCheckpointNativeObjectOutput)"/>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(QylEmbedDashboard)' == 'true' AND Exists('..\qyl.dashboard\dist\index.html')">
    <EmbeddedResource Include="..\qyl.dashboard\dist\**\*" LinkBase="wwwroot"/>
  </ItemGroup>

  <!-- Plain builds may omit the dashboard; an embed-enabled publish may not. -->
  <Target Name="QylRequireDashboardDistForPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(QylEmbedDashboard)' == 'true' AND !Exists('..\qyl.dashboard\dist\index.html')">
    <Error Text="QylEmbedDashboard=true but services/qyl.dashboard/dist/index.html does not exist. Build the dashboard first (npm run build in services/qyl.dashboard) or publish with -p:QylEmbedDashboard=false."/>
  </Target>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf"/>
    <PackageReference Include="Grpc.AspNetCore"/>
    <PackageReference Include="Grpc.Tools" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.Middleware"/>
    <PackageReference Include="Microsoft.Extensions.Telemetry"/>
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction"/>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Common"/>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.ResourceUtilization"/>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.ResourceMonitoring"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AsyncState"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Qyl.Api.Contracts"/>
    <ProjectReference Include="..\..\internal\qyl.instrumentation\qyl.instrumentation.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qyl.Collector.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\internal\qyl.instrumentation.generators\qyl.instrumentation.generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\internal\qyl.collector.storage.generators\qyl.collector.storage.generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/google/rpc/status.proto" ProtoRoot="Protos" GrpcServices="None"/>
    <Protobuf Include="Protos/opentelemetry/proto/common/v1/common.proto" ProtoRoot="Protos" GrpcServices="None"/>
    <Protobuf Include="Protos/opentelemetry/proto/resource/v1/resource.proto" ProtoRoot="Protos" GrpcServices="None"/>
    <Protobuf Include="Protos/opentelemetry/proto/trace/v1/trace.proto" ProtoRoot="Protos" GrpcServices="None"/>
    <Protobuf Include="Protos/opentelemetry/proto/logs/v1/logs.proto" ProtoRoot="Protos" GrpcServices="None"/>
    <Protobuf Include="Protos/opentelemetry/proto/metrics/v1/metrics.proto" ProtoRoot="Protos" GrpcServices="None"/>
    <Protobuf Include="Protos/opentelemetry/proto/collector/trace/v1/trace_service.proto" ProtoRoot="Protos" GrpcServices="Server"/>
    <Protobuf Include="Protos/opentelemetry/proto/collector/logs/v1/logs_service.proto" ProtoRoot="Protos" GrpcServices="Server"/>
    <Protobuf Include="Protos/opentelemetry/proto/collector/metrics/v1/metrics_service.proto" ProtoRoot="Protos" GrpcServices="Server"/>
  </ItemGroup>

</Project>
