<Project Sdk="ANcpLua.NET.Sdk">
  <!-- DuckDB persistence. Its compile assets stay private to this assembly, so the host and the
       tests reach DuckDB only through IQylStore and the other storage intent methods. -->
  <PropertyGroup>
    <RootNamespace>Qyl.Collector.Storage</RootNamespace>
    <LangVersion>14</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" PrivateAssets="compile"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../qyl.collector.ingestion/qyl.collector.ingestion.csproj"/>
    <ProjectReference Include="../../internal/qyl.collector.storage.generators/qyl.collector.storage.generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="qyl.collector"/>
    <InternalsVisibleTo Include="Qyl.Collector.Tests"/>
  </ItemGroup>

</Project>
