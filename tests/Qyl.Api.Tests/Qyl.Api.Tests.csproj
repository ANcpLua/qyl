<Project Sdk="MSTest.Sdk">
  <!--
    Proof for the Qyl.Api runtime that is not the XML generator: the agent contract. A request's
    W3C `baggage` header carries `session.id`; the server span must carry it afterwards, and must
    carry nothing when the header says nothing. The host is composed with AddQyl, as AddQylApi
    composes it, whose startup filter does the stamping, so the test fails the same way production would.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Qyl.Telemetry.Hosting"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/Qyl.Api.Sdk/Qyl.Api/Qyl.Api.csproj"/>
  </ItemGroup>

</Project>
