<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Compose and supervise local .NET services and executables with qyl's process orchestrator.</Description>
    <PackageTags>qyl;orchestration;hosting;testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="System.Globalization" />
    <Using Include="System.Text" />
    <InternalsVisibleTo Include="Qyl.Cli" />
    <InternalsVisibleTo Include="Qyl.Cli.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
