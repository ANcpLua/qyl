<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Packs qyl.sdk/ as the Qyl.Api.Sdk MSBuild SDK: `dotnet pack qyl.sdk/Qyl.Api.Sdk.csproj -o <feed>`.
    Nothing is compiled here; the nuspec lists Sdk/, Build/, Sources/, the Qyl.Xml assembly, and the generator, built by the
    project references. net10.0 only so the reference to Qyl.Xml (net10.0) restores.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-alpha</Version>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NuspecFile>Qyl.Api.Sdk.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version);configuration=$(Configuration)</NuspecProperties>
    <!-- CS2008: no source files, by design. NU5128: lib/ without a dependency group, by design (an MSBuild SDK, not a package reference). -->
    <NoWarn>$(NoWarn);CS2008;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Qyl.Xml/Qyl.Xml.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Qyl.Sdk.Xml.Generator/Qyl.Sdk.Xml.Generator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
