<Project>
  <!--
    Package versions pinned by the Qyl SDK. Consumers do not declare these; the SDK does.
    Every value resolves through a property owned by the repository's Version.props, so a bump
    is a one-line edit in one place. Qyl.Api.Sdk.csproj writes the resolved copy of this file
    into the package, because a consumer outside this repository has no Version.props to read.
  -->
  <PropertyGroup>
    <_QylSdkPackagesImported>true</_QylSdkPackagesImported>
  </PropertyGroup>

  <!-- Honoured under Central Package Management only; a consumer without CPM gets the package's own dependency range. -->
  <ItemGroup>
    <!-- Transitive pin so the document model cannot drift underneath Microsoft.AspNetCore.OpenApi -->
    <PackageVersion Include="Microsoft.OpenApi" Version="$(MicrosoftOpenApiVersion)" />
  </ItemGroup>
</Project>
