<Project>
  <PropertyGroup>
    <!-- Packed form: the generator ships under analyzers/dotnet/cs; in-repo form: it is a project next to this file. -->
    <_QylSdkPackagedGenerator>$(QylSdkRoot)analyzers/dotnet/cs/Qyl.Sdk.Xml.Generator.dll</_QylSdkPackagedGenerator>
    <_QylSdkPackagedXml>$(QylSdkRoot)lib/net10.0/Qyl.Xml.dll</_QylSdkPackagedXml>
    <_QylSdkPackagedApi>$(QylSdkRoot)lib/net10.0/Qyl.Api.dll</_QylSdkPackagedApi>
    <QylSdkPackaged Condition="'$(QylSdkPackaged)' == '' and Exists('$(_QylSdkPackagedGenerator)')">true</QylSdkPackaged>
  </PropertyGroup>

  <!-- Implicit references carry their own version: the SDK owns them (NU1009 forbids a PackageVersion for an implicit reference). -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"
                      VersionOverride="$(QylAspNetCoreOpenApiVersion)"
                      IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server"
                      Condition="'$(QylEmitOpenApiDocument)' == 'true'"
                      VersionOverride="$(QylApiDescriptionServerVersion)"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
                      IsImplicitlyDefined="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"
                      Version="$(QylAspNetCoreOpenApiVersion)"
                      IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server"
                      Condition="'$(QylEmitOpenApiDocument)' == 'true'"
                      Version="$(QylApiDescriptionServerVersion)"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
                      IsImplicitlyDefined="true" />
  </ItemGroup>

  <!-- The compiled SDK: the Qyl.Xml contract and the Qyl.Api runtime as references, the [GenerateXml] generator as an analyzer only. -->
  <ItemGroup Condition="'$(QylSdkPackaged)' == 'true'">
    <Reference Include="Qyl.Xml">
      <HintPath>$(_QylSdkPackagedXml)</HintPath>
    </Reference>
    <Reference Include="Qyl.Api">
      <HintPath>$(_QylSdkPackagedApi)</HintPath>
    </Reference>
    <Analyzer Include="$(_QylSdkPackagedGenerator)" />
  </ItemGroup>
  <ItemGroup Condition="'$(QylSdkPackaged)' != 'true'">
    <ProjectReference Include="$(QylSdkXmlProject)" />
    <ProjectReference Include="$(QylSdkApiProject)" />
    <!--
      No SetTargetFramework: the generator has one target framework, and forcing it as a global property would build a second
      instance of the project, whose rebuild races the first instance's output away from other referrers (the tests).
    -->
    <ProjectReference Include="$(QylSdkXmlGeneratorProject)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Build-time values the SDK sources read at runtime, written before compilation so MSBuild, not code, owns them.
    Properties are evaluated inside the target because IntermediateOutputPath is defined by Microsoft.Common.targets,
    which imports after this file. Semicolons are escaped as %3B: WriteLinesToFile would otherwise split the source.
  -->
  <Target Name="QylGenerateSdkBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_QylSdkBuildInfoFile>$(IntermediateOutputPath)QylSdkBuild.g.cs</_QylSdkBuildInfoFile>
      <_QylSdkBuildInfoSource>// &lt;auto-generated/&gt;
// Written by Qyl.Sdk.Api.targets from MSBuild properties. Change the property, not this file.
#nullable enable
namespace Qyl
{
    /// &lt;summary&gt;Values fixed at build time by the Qyl SDK's MSBuild properties.&lt;/summary&gt;
    internal static class QylSdkBuild
    {
        /// &lt;summary&gt;The OpenAPI specification version (`QylOpenApiVersion`), shared with the build-time document tool.&lt;/summary&gt;
        public const global::Microsoft.OpenApi.OpenApiSpecVersion OpenApiVersion = global::Microsoft.OpenApi.OpenApiSpecVersion.$(QylOpenApiVersion)%3B
    }
}</_QylSdkBuildInfoSource>
    </PropertyGroup>

    <WriteLinesToFile File="$(_QylSdkBuildInfoFile)" Lines="$(_QylSdkBuildInfoSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_QylSdkBuildInfoFile)" Link="qyl.sdk/QylSdkBuild.g.cs" />
      <FileWrites Include="$(_QylSdkBuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Keep every generator's output inspectable. The path is scoped by configuration and target
    framework because BaseIntermediateOutputPath is per project, not per build: a repository that
    redirects it (this one points it at artifacts/obj/<project>/) would otherwise have a Debug and
    a Release build overwrite each other's generated sources in one directory. IntermediateOutputPath
    itself is not usable here — Microsoft.Common.targets defines it after this file is imported.
  -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
