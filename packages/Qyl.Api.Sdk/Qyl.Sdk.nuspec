<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Qyl.Sdk</id>
    <version>$version$</version>
    <authors>ANcpLua</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>MSBuild SDK for Qyl APIs: the ASP.NET Core Native AOT template plus compile-time validation, [GenerateXml] XML output, and a committed OpenAPI contract, behind AddQylApi(). Use with &lt;Project Sdk="Qyl.Sdk/$version$"&gt;.</description>
    <packageTypes>
      <packageType name="MSBuildSdk" />
    </packageTypes>
  </metadata>
  <files>
    <file src="Sdk/Sdk.props" target="Sdk/" />
    <file src="Sdk/Sdk.targets" target="Sdk/" />
    <file src="Build/Qyl.Sdk.Api.props" target="Build/" />
    <file src="Build/Qyl.Sdk.Api.targets" target="Build/" />
    <file src="Build/Qyl.Sdk.Packages.props" target="Build/" />
    <file src="Sources/**/*.cs" target="Sources/" />
    <file src="Qyl.Sdk.Xml.Generator/bin/$configuration$/netstandard2.0/Qyl.Sdk.Xml.Generator.dll" target="analyzers/dotnet/cs/" />
    <file src="DECISIONS.md" target="" />
  </files>
</package>
